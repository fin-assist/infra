# Not included for fake-phone stage. Real-provider activation is separately accepted.
location = /callbacks/zvonok {
    allow 193.232.64.150;
    deny all;
    access_log off;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_pass http://127.0.0.1:9095;
}
